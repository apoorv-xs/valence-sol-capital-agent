# Agent wallet — base58 encoded private key (Solana keypair)
# NEVER commit this file. Add .env to .gitignore.
AGENT_KEYPAIR_B58=YOUR_BASE58_PRIVATE_KEY_HERE

# Solana RPC endpoint (optional — defaults to mainnet-beta)
# For better performance use a dedicated RPC provider:
# SOLANA_RPC=https://your-rpc-provider.com
